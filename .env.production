# URL de la API para el export web publicado. Expo la lee sola al correr
# `npx expo export --platform web` y la mete en el bundle: sin este archivo,
# el export sale con la IP de desarrollo y la demo no puede hablar con la API.
# Sólo URLs: todo lo que lleve EXPO_PUBLIC_ viaja al navegador.
EXPO_PUBLIC_API_URL=https://pocket-api.lautaromoreyra.dev

# Clave del sitio de Turnstile (widget pocket-demo en Cloudflare). Es publica
# por diseno: el secreto que la valida vive solo en la API.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFlS8T5RwmXJpvGi
